@echo off
setlocal DisableDelayedExpansion
chcp 65001 >nul
set "ASSISTANT_WORKSHOP_PACKAGE=%~dp0"
powershell.exe -NoLogo -NoProfile -Command "$ErrorActionPreference='Stop'; try { function Msg([string]$zh,[string]$en) { if ($env:ASSISTANT_INSTALL_LANGUAGE -eq 'en') { $en } else { $zh } }; function Hash-File([string]$path) { $hasher=[Security.Cryptography.SHA256]::Create(); try { ([BitConverter]::ToString($hasher.ComputeHash([IO.File]::ReadAllBytes($path)))).Replace('-','') } finally { $hasher.Dispose() } }; $source=Join-Path $env:ASSISTANT_WORKSHOP_PACKAGE 'BarotraumaModAssistant.exe'; $hashFile=Join-Path $env:ASSISTANT_WORKSHOP_PACKAGE 'SHA256SUMS.txt'; if (!(Test-Path -LiteralPath $source) -or !(Test-Path -LiteralPath $hashFile)) { throw (Msg '工坊下载尚未完成，缺少程序或校验文件。' 'Workshop download is incomplete; executable or checksums missing.') }; $line=@(Get-Content -LiteralPath $hashFile -Encoding UTF8 | Where-Object { $_ -match '^[a-f0-9]{64}  BarotraumaModAssistant\.exe$' }); if ($line.Count -ne 1) { throw (Msg '程序校验记录不正确。' 'Invalid executable checksum record.') }; $expected=$line[0].Substring(0,64); if ((Hash-File $source) -ine $expected) { throw (Msg '程序校验失败，请重新下载工坊项目。' 'Executable checksum failed. Download the Workshop item again.') }; $program=Join-Path ([Environment]::GetFolderPath('LocalApplicationData')) 'BarotraumaModAssistant\WorkshopProgram'; $target=Join-Path $program 'BarotraumaModAssistant.exe'; New-Item -ItemType Directory -Path $program -Force | Out-Null; Copy-Item -LiteralPath $source -Destination $target -Force; if ((Hash-File $target) -ine $expected) { throw (Msg '复制后的程序校验失败。' 'Copied executable checksum failed.') }; foreach ($doc in @('使用说明.md','README_EN.md','ACCESS_AND_PRIVACY.md','evidence-workflows.md')) { $docSource=Join-Path $env:ASSISTANT_WORKSHOP_PACKAGE $doc; if (Test-Path -LiteralPath $docSource) { Copy-Item -LiteralPath $docSource -Destination (Join-Path $program $doc) -Force } }; $shell=New-Object -ComObject WScript.Shell; $desktop=[Environment]::GetFolderPath('Desktop'); $shortcutPath=Join-Path $desktop (Msg 'BaroDock（工坊版）.lnk' 'BaroDock (Workshop).lnk'); $previousPath=Join-Path $desktop (Msg 'BaroPy（工坊版）.lnk' 'BaroPy (Workshop).lnk'); if (!(Test-Path -LiteralPath $shortcutPath) -and (Test-Path -LiteralPath $previousPath)) { $previous=$shell.CreateShortcut($previousPath); if ($previous.TargetPath -ieq $target -and [IO.Path]::GetDirectoryName([IO.Path]::GetFullPath($previousPath)) -ieq [IO.Path]::GetFullPath($desktop) -and [IO.Path]::GetDirectoryName([IO.Path]::GetFullPath($shortcutPath)) -ieq [IO.Path]::GetFullPath($desktop)) { Move-Item -LiteralPath $previousPath -Destination $shortcutPath } }; $link=$shell.CreateShortcut($shortcutPath); $link.TargetPath=$target; $link.WorkingDirectory=$program; $link.IconLocation=$target; $link.Description=(Msg 'BaroDock v0.10.0 - 工坊分发版' 'BaroDock v0.10.0 - Workshop edition'); $link.Save(); Write-Host (Msg '已创建桌面入口：BaroDock（工坊版）' 'Desktop shortcut created: BaroDock (Workshop)'); Write-Host (Msg '个人设置已保留；以后从桌面启动助手即可。' 'Your settings are retained. Start the assistant from the desktop.'); exit 0; } catch { Write-Host ((Msg '创建失败：' 'Installation failed; close the assistant and check folder access: ')+$_.Exception.Message); exit 1 }"
if errorlevel 1 (
  pause
  exit /b 1
)
pause
exit /b 0
